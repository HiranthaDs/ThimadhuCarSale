# Copy this file to .env and fill in real values. .env itself is gitignored —
# never commit real secrets.

DATABASE_URL=postgresql://user:password@host:5432/dbname
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
# Must be between 5 and 120, or the app refuses to start.
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Render: COOKIE_SECURE=true and COOKIE_SAMESITE=none when the frontend is on a
# different domain (SameSite=none requires secure). Use lax with a shared custom domain.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Hostnames only (no https://), comma-separated. Render: your API host,
# e.g. yourapi.onrender.com. Anything else gets "Invalid host header" (400).
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_SSLMODE=verify-full
DATABASE_SSLROOTCERT=certs/prod-ca-2021.crt
# Render free plan (512MB): pool 3 + overflow 2, with WEB_CONCURRENCY=1.
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
AUTO_MIGRATE=false

# Render deployment (set in the Render dashboard, not read from this file):
#   WEB_CONCURRENCY=1                 one worker fits the free plan's memory
#   FORWARDED_ALLOW_IPS=*             trust Render's proxy so real client IPs are used
#   APP_ENV=production
# The Dockerfile already sets --timeout-keep-alive 120 (must exceed the proxy's idle timeout).
PRIVATE_DOWNLOAD_SECONDS=900

# Set a unique 16+ character bootstrap password for migration only, then clear it.
OWNER_BOOTSTRAP_EMAIL=
OWNER_BOOTSTRAP_PASSWORD=
OWNER_BOOTSTRAP_NAME=Owner

# Exact frontend origin(s), comma-separated, no trailing slash, no "*".
# Render/Pages: add https://your-frontend.pages.dev (or onrender.com URL).
CORS_ORIGINS=http://localhost:5173

# File storage (Cloudflare R2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REPORTS_BUCKET=
# Legacy URL prefix for existing records; disable public access to the bucket.
R2_REPORTS_PUBLIC_URL=
R2_BLACKLIST_BUCKET=
R2_BLACKLIST_PUBLIC_URL=

# Local development only. Production requires HTTPS, COOKIE_SECURE=true, and explicit hosts/origins.
# Set to "production" once the API is live, to close them off.
APP_ENV=development

# Hard cap on request bodies, in bytes. Default is 30MB.
MAX_REQUEST_BODY_BYTES=31457280

# Password reset email: smtp or brevo_api. Verify the sender in Brevo.
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp-relay.brevo.com
# Port 587/2525 requires STARTTLS; 465 uses implicit TLS.
SMTP_PORT=587
SMTP_USERNAME=
# Brevo SMTP key (not an API key or Gmail password).
SMTP_PASSWORD=
SMTP_SENDER_EMAIL=
SMTP_SENDER_NAME=Thimadhu

# Optional HTTPS API settings, used only with EMAIL_PROVIDER=brevo_api.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Thimadhu
PASSWORD_RESET_EXPIRE_MINUTES=10
PASSWORD_RESET_RESEND_SECONDS=60
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_MAX_SENDS_PER_HOUR=20
