# Copy this file to .env and fill in real values. .env itself is gitignored —
# never commit real secrets.

DATABASE_URL=postgresql://user:password@host:5432/dbname
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Bootstrap owner account created automatically on first startup if no owner exists yet.
OWNER_BOOTSTRAP_EMAIL=
OWNER_BOOTSTRAP_PASSWORD=
OWNER_BOOTSTRAP_NAME=Owner

CORS_ORIGINS=http://localhost:5173

# File storage (Cloudflare R2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REPORTS_BUCKET=
R2_REPORTS_PUBLIC_URL=
R2_BLACKLIST_BUCKET=
R2_BLACKLIST_PUBLIC_URL=

# "development" (default) leaves /docs, /redoc and /openapi.json open.
# Set to "production" once the API is live, to close them off.
APP_ENV=development

# Login brute-force lockout.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Hard cap on request bodies, in bytes. Default is 30MB.
MAX_REQUEST_BODY_BYTES=31457280

# Password reset email: smtp or brevo_api. Verify the sender in Brevo.
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp-relay.brevo.com
# Port 587/2525 requires STARTTLS; 465 uses implicit TLS.
SMTP_PORT=587
SMTP_USERNAME=
# Brevo SMTP key (not an API key or Gmail password).
SMTP_PASSWORD=
SMTP_SENDER_EMAIL=
SMTP_SENDER_NAME=Thimadhu

# Optional HTTPS API settings, used only with EMAIL_PROVIDER=brevo_api.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Thimadhu
PASSWORD_RESET_EXPIRE_MINUTES=10
PASSWORD_RESET_RESEND_SECONDS=60
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_MAX_SENDS_PER_HOUR=5
